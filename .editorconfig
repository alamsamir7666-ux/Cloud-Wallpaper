root = true

[*.{kt,kts}]
ktlint_code_style = official
# Allow PascalCase @Composable function names (Compose convention).
ktlint_function_naming_ignore_when_annotated_with = Composable
# Route constants ("browse", "detail/{id}") use camelCase per Navigation
# Compose convention, not SCREAMING_SNAKE_CASE.
ktlint_standard_property-naming = disabled

[*.{yml,yaml}]
indent_size = 2
