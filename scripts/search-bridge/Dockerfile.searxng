# Combined image: SearXNG metasearch + the Cloudimage bridge, ONE container.
#
# The bridge is the public surface (platform $PORT, default 3000); SearXNG
# listens only on the container loopback (:8080) and is never reachable
# from outside. The bridge's `searxng` provider talks to it over
# 127.0.0.1 — no API keys, no quotas, unlimited searches. Deploy runbook:
# DEPLOY.md in this directory.
FROM docker.io/searxng/searxng:latest

# The bridge is dependency-free Node — copying the binary from the official
# alpine image plus its runtime libs is the entire install. The searxng base
# is a minimal busybox rootfs WITHOUT a system libc: the musl interpreter and
# the C++ runtime libs must come along, or busybox sh fails every exec with
# "node: not found" (exit 127 — what killed the first deploy attempt).
COPY --from=docker.io/library/node:20-alpine /usr/local/bin/node /usr/local/bin/node
COPY --from=docker.io/library/node:20-alpine /lib/ld-musl-x86_64.so.1 /lib/ld-musl-x86_64.so.1
COPY --from=docker.io/library/node:20-alpine /usr/lib/libstdc++.so.6 /usr/lib/libstdc++.so.6
COPY --from=docker.io/library/node:20-alpine /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1

# Build-time gate: actually exec the binary. A broken loader or a missing
# lib fails the BUILD here with a readable message, instead of surfacing
# only after the deploy as a runtime crash loop.
RUN node --version

# SearXNG instance settings ship at /app — NOT /etc/searxng: the base
# image declares /etc/searxng a VOLUME, and Docker discards build-time
# changes to volume paths at runtime. The start script copies this file
# to /tmp and points SEARXNG_SETTINGS_PATH at it.
COPY settings.yml /app/searxng-settings.yml

# The bridge itself.
COPY server.js package.json /app/
COPY start-searxng-bridge.sh /usr/local/bin/start-searxng-bridge.sh
RUN chmod +x /usr/local/bin/start-searxng-bridge.sh

ENV PORT=3000 \
    SEARCH_PROVIDER=searxng \
    SEARXNG_BASE=http://127.0.0.1:8080 \
    NODE_OPTIONS=--max-old-space-size=64 \
    PROXY_CACHE_MAX=100 \
    PROXY_CACHE_BUDGET_MB=64 \
    PROXY_CACHEABLE_MAX_MB=3 \
    GRANIAN_INTERFACE=wsgi \
    GRANIAN_HOST=127.0.0.1 \
    GRANIAN_PORT=8080 \
    GRANIAN_WEBSOCKETS=false \
    GRANIAN_BLOCKING_THREADS=4 \
    GRANIAN_WORKERS_KILL_TIMEOUT=30s

EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/start-searxng-bridge.sh"]
