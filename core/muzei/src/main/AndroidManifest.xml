<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Cloudimage as a Muzei source (v1.0.4). Muzei discovers the
             provider through the intent action and guards cross-app access
             with its own permission; on every load it calls
             CloudimageMuzeiArtProvider.onLoadRequested, which hands the
             actual selection work to MuzeiArtworkWorker. -->
        <provider
            android:name="com.cloudimage.core.muzei.CloudimageMuzeiArtProvider"
            android:authorities="${applicationId}.muzei"
            android:label="@string/muzei_source_name"
            android:description="@string/muzei_source_description"
            android:exported="true"
            android:permission="com.google.android.apps.muzei.api.ACCESS_PROVIDER">
            <intent-filter>
                <action android:name="com.google.android.apps.muzei.api.MuzeiArtProvider" />
            </intent-filter>
        </provider>

        <!-- Exposes the current artwork to document UIs (Downloads, pickers),
             exactly like the official example sources do. -->
        <provider
            android:name="com.google.android.apps.muzei.api.provider.MuzeiArtDocumentsProvider"
            android:authorities="${applicationId}.muzei.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
